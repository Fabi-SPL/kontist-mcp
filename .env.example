# Kontist API credentials
# Obtain from https://kontist.dev after logging into your Kontist account
# OAuth2 flow: register an app → get client_id + client_secret → run auth flow → store refresh token

KONTIST_CLIENT_ID=
KONTIST_CLIENT_SECRET=

# Long-lived refresh token (obtained from one-time OAuth flow)
KONTIST_REFRESH_TOKEN=

# Account ID (returned from /api/me query — auto-populated after first auth)
KONTIST_ACCOUNT_ID=

# Optional: override the default GraphQL endpoint
KONTIST_API_URL=https://api.kontist.com/api/graphql
KONTIST_AUTH_URL=https://api.kontist.com/api/oauth/token

# Local dev only — port for the OAuth callback during initial setup
OAUTH_CALLBACK_PORT=8765
