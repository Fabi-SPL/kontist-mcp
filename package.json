{
  "name": "kontist-mcp",
  "version": "0.1.0",
  "description": "OAuth2 client and typed GraphQL layer over the Kontist business banking API, exposed over the Model Context Protocol.",
  "type": "module",
  "private": true,
  "bin": {
    "kontist-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "setup": "tsx src/setup-oauth.ts",
    "test:auth": "tsx src/test-auth.ts",
    "test:balance": "tsx src/test-balance.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "dotenv": "^16.4.5",
    "graphql": "^16.9.0",
    "graphql-request": "^7.1.2",
    "kontist": "^0.52.15",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
